{
  "name": "pi-workflow",
  "version": "1.0.0",
  "description": "Thin workflow orchestration package for Pi.",
  "files": [
    "src",
    "workflow-scripts",
    "skills",
    "agents",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "validate:unit5:isolated": "node scripts/validate-unit5-isolated.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "keywords": [
    "pi-package"
  ],
  "author": "",
  "license": "ISC",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "pi-ketch": "git+https://github.com/minorunakamura/pi-ketch.git#e49fd9ea48b675eef2ede729c9f13f7e12d44c20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.4.1",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pi-subagents": "0.67.0",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "pi-subagents": "0.67.0",
    "typebox": "*"
  }
}
