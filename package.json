{
  "name": "pi-workflow",
  "version": "1.0.0",
  "description": "Workflow runtime package for Pi",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:story-12-05": "node scripts/story-12-05-platform-matrix.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "keywords": [
    "pi-package"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.22.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/extensions/workflow.ts",
      "./node_modules/pi-subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "bundledDependencies": [
    "pi-subagents"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pi-subagents": ">=0.49.0 <0.65.0",
    "yaml": "^2.9.0"
  }
}
